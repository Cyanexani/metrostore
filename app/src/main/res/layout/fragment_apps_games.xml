<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metro_black"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@color/metro_black"
        android:paddingStart="8dp"
        app:contentInsetStartWithNavigation="20dp"
        app:titleTextAppearance="@style/TextAppearance.Metro.Toolbar"
        app:menu="@menu/menu_main" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_below="@id/toolbar"
        android:background="@android:color/transparent"
        app:tabGravity="start"
        app:tabIndicatorColor="@android:color/transparent"
        app:tabIndicatorHeight="0dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="@dimen/padding_normal"
        app:tabPaddingStart="@dimen/padding_normal"
        app:tabSelectedTextColor="@color/metro_white"
        app:tabTextAppearance="@style/TextAppearance.Metro.Tab"
        app:tabTextColor="@color/metro_gray" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tab_layout" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/search_fab"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/margin_large"
        android:background="@drawable/bg_metro_search"
        android:contentDescription="@string/action_search"
        android:padding="13dp"
        app:srcCompat="@drawable/ic_round_search"
        app:tint="@color/metro_white" />
</RelativeLayout>
